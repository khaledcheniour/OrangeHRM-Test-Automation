# ===========================================================================
# Git ignore rules for a Python + Playwright project
# ===========================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Test / tool caches ---
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*

# --- Reports & artifacts produced by test runs ---
reports/
test-results/
test-artifacts/
allure-results/
allure-report/
*.png
*.webm
*.zip
trace.zip
GUIDE.md
# --- Secrets & local config ---
.env

# --- IDE / OS files ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
